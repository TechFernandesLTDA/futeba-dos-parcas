    <!-- Privacy - Photo Library -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>O Futeba dos Parças usa suas fotos para você escolher a foto de perfil e compartilhar imagens dos jogos.</string>

    <!-- Privacy - Location -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>O Futeba dos Parças usa sua localização para mostrar jogos e quadras perto de você e confirmar o check-in na pelada.</string>

    <!-- Export compliance: o app só usa criptografia padrão do sistema (HTTPS/TLS) -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- AdMob: ID do app e da unidade vêm da config de build (project.yml): teste no Debug,
