<?xml version="1.0" encoding="utf-8"?>
<!--
  Só no build de DEBUG. O manifesto principal proíbe HTTP sem TLS
  (usesCleartextTraffic=false) e continua valendo para todo o resto.
  A exceção é o Firebase Emulator Suite, que só fala HTTP: 10.0.2.2 é o Mac
  visto de dentro do emulador Android; localhost cobre `adb reverse` em aparelho.
  Usado pela bateria de testes (scripts/bateria/rodar.sh android).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
