rules_version = '2';

// ============================================
// FIREBASE STORAGE SECURITY RULES
// Futeba dos Parças - v1.4.2
//
// Estrutura de Caminhos Padronizada:
// - users/{userId}/profile.jpg
// - groups/{groupId}/logo.{jpg|jpeg|png|webp}
// - groups/{groupId}/receipts/{timestamp}.{jpg|png|webp}
// - locations/{locationId}/photos/{timestamp}.jpg
// - locations/{locationId}/fields/{timestamp}.jpg
// - temp_fields/{timestamp}.jpg (temporário, sem locationId)
// - games/{gameId}/photos/{userId}/{timestamp}.jpg
// ============================================

service firebase.storage {
  match /b/{bucket}/o {

    // ============================================
    // FUNÇÕES AUXILIARES
    // ============================================

    // Verifica se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica se o usuário é o dono do recurso
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verifica se o usuário é membro ATIVO do grupo
    // #2160: exige status == ACTIVE — membro banido/removido não mantém acesso
    function isGroupMember(groupId) {
      let memberDoc = firestore.get(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid));
      return memberDoc != null && memberDoc.data.status == 'ACTIVE';
    }

    // Verifica se o usuário é admin do grupo.
    // Usa um único firestore.get() — em Storage Rules o get() retorna null
    // quando o documento não existe (diferente do comportamento em Firestore Rules),
    // portanto não é necessário preceder com exists(), economizando 1 read por operação.
    function isGroupAdmin(groupId) {
      let memberDoc = firestore.get(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid));
      return isAuthenticated() &&
             memberDoc != null &&
             memberDoc.data.role in ['OWNER', 'ADMIN'] &&
             memberDoc.data.status == 'ACTIVE';
    }

    // Verifica se o usuário é admin do sistema via Custom Claims (zero Firestore reads).
    // Requer token JWT atualizado — usuário precisa re-logar após promoção para obter claim.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'ADMIN';
    }

    // Verifica se o arquivo é uma imagem válida.
    // Blacklist explícito de SVG/XML para prevenir XSS via imagem com script embutido.
    function isImage() {
      return request.resource.contentType.matches('image/.*') &&
             !(request.resource.contentType in ['image/svg+xml', 'image/svg', 'image/xml']);
    }

    // Verifica tamanho máximo do arquivo (em MB)
    function isUnderSize(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }

    // ============================================
    // FOTOS DE PERFIL DE USUÁRIOS
    // Path: users/{userId}/profile.jpg e users/{userId}/thumb.jpg
    // Cache-Control: public, max-age=2592000 (30 dias)
    // ============================================
    match /users/{userId}/{fileName} {
      // Qualquer usuário autenticado pode ler fotos de perfil
      // As regras de cache são definidas via metadados no upload
      allow read: if isAuthenticated() && fileName in ['profile.jpg', 'thumb.jpg'];

      // Apenas o próprio usuário pode escrever suas fotos
      // Máximo 2MB, apenas imagem, valida contentType
      // FIX #2649: restringe filenames para prevenir quota abuse
      allow write: if isOwner(userId) && isImage() && isUnderSize(2) && fileName in ['profile.jpg', 'thumb.jpg'];

      // Apenas o próprio usuário pode deletar
      allow delete: if isOwner(userId) && fileName in ['profile.jpg', 'thumb.jpg'];
    }

    // ============================================
    // THUMBNAILS DE PERFIL DE USUÁRIOS
    // Path: users/{userId}/thumbnails/{fileName}
    // Gerados por Cloud Functions (generate-thumbnails).
    // #2158: Leitura publica, escrita apenas Admin SDK.
    // ============================================
    match /users/{userId}/thumbnails/{fileName} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ============================================
    // LOGOS DE GRUPOS
    // Path: groups/{groupId}/logo.{jpg|jpeg|png|webp}
    //
    // SEGURANÇA: Upload restrito a admins/owners do grupo via isGroupAdmin().
    // A função isGroupAdmin() lê o documento groups/{groupId}/members/{uid}
    // via firestore.get(), verificando role == 'OWNER' || role == 'ADMIN'.
    //
    // LIMITAÇÃO CONHECIDA: Storage Rules têm cota limitada de leituras ao
    // Firestore (firestore.get/exists). Em cenários de alta frequência de
    // upload, pode haver rate limiting. Se isso ocorrer, o fallback é:
    // desabilitar temporariamente isGroupAdmin() e manter a validação
    // apenas na camada de app (GroupRepository.updateGroup + Cloud Function).
    // ============================================
    match /groups/{groupId}/{fileName} {
      // Qualquer usuário autenticado pode ver logos de grupos
      // (necessário para preview em convites, buscas, etc.)
      allow read: if isAuthenticated() && fileName.matches('logo\\.(jpg|jpeg|png|webp)');

      // Apenas admins ou owners do grupo podem fazer upload do logo
      // Máximo 5MB, apenas imagem
      allow write: if isAuthenticated() &&
                   fileName.matches('logo\\.(jpg|jpeg|png|webp)') &&
                   isGroupAdmin(groupId) &&
                   isImage() &&
                   isUnderSize(5);

      // Apenas admins ou owners do grupo podem deletar o logo
      allow delete: if isAuthenticated() &&
                    fileName.matches('logo\\.(jpg|jpeg|png|webp)') &&
                    isGroupAdmin(groupId);
    }

    // ============================================
    // THUMB DE GRUPO (Android)
    // Path: groups/{groupId}/thumb.jpg
    // #2158: Android usa este path. Mesma permissao do logo.
    // ============================================
    match /groups/{groupId}/thumb.jpg {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isGroupAdmin(groupId) && isImage() && isUnderSize(5);
      allow delete: if isAuthenticated() && isGroupAdmin(groupId);
    }

    // ============================================
    // THUMBNAILS DE GRUPO (gerados por Cloud Functions)
    // Path: groups/{groupId}/thumbnails/{fileName}
    // #2158: Leitura publica, escrita apenas Admin SDK.
    // ============================================
    match /groups/{groupId}/thumbnails/{fileName} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ============================================
    // COMPROVANTES DO CAIXINHA
    // Path: groups/{groupId}/receipts/{timestamp}.jpg
    // ============================================
    match /groups/{groupId}/receipts/{fileName} {
      // Membros do grupo podem ver os comprovantes
      allow read: if isAuthenticated() && isGroupMember(groupId);

      // Apenas admins podem fazer upload de comprovantes
      // Máximo 5MB, apenas imagem
      allow write: if isAuthenticated() && isGroupAdmin(groupId) && isImage() && isUnderSize(5);

      // Apenas admins podem deletar
      allow delete: if isAuthenticated() && isGroupAdmin(groupId);
    }

    // ============================================
    // FOTOS DE LOCAIS — PATH FLAT (Web)
    // Path: locations/{locationId}/{fileName}
    // #2158: Web usa locations/{id}/photo.jpg (sem subpasta photos/).
    // Owner/manager do local pode escrever.
    // ============================================
    match /locations/{locationId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
                     (firestore.get(/databases/(default)/documents/locations/$(locationId)).data.owner_id == request.auth.uid ||
                      request.auth.uid in firestore.get(/databases/(default)/documents/locations/$(locationId)).data.get('managers', [])) &&
                     isImage() && isUnderSize(5);
      allow delete: if isAuthenticated() &&
                      (firestore.get(/databases/(default)/documents/locations/$(locationId)).data.owner_id == request.auth.uid ||
                       request.auth.uid in firestore.get(/databases/(default)/documents/locations/$(locationId)).data.get('managers', []));
    }

    // ============================================
    // FOTOS DE LOCAIS (FIELD/Locais)
    // Path: locations/{locationId}/photos/{timestamp}.jpg
    // ============================================
    match /locations/{locationId}/photos/{fileName} {
      // Qualquer usuário autenticado pode ver fotos de locais
      allow read: if isAuthenticated();

      // #1573: owner OU manager do local pode fazer upload (paridade com Firestore rules)
      // Máximo 5MB por foto, apenas imagem
      allow write: if isAuthenticated() &&
                     (firestore.get(/databases/(default)/documents/locations/$(locationId)).data.owner_id == request.auth.uid ||
                      request.auth.uid in firestore.get(/databases/(default)/documents/locations/$(locationId)).data.get('managers', [])) &&
                     isImage() && isUnderSize(5);

      // #1573: owner OU manager do local pode deletar (paridade com Firestore rules)
      allow delete: if isAuthenticated() &&
                      (firestore.get(/databases/(default)/documents/locations/$(locationId)).data.owner_id == request.auth.uid ||
                       request.auth.uid in firestore.get(/databases/(default)/documents/locations/$(locationId)).data.get('managers', []));
    }

    // ============================================
    // FOTOS DE CAMPOS (Fields dentro de Locations)
    // Path: locations/{locationId}/fields/{timestamp}.jpg
    // ============================================
    match /locations/{locationId}/fields/{fileName} {
      // Qualquer usuário autenticado pode ver fotos de campos
      allow read: if isAuthenticated();

      // #1573: owner OU manager do local pode fazer upload (paridade com Firestore rules)
      // Máximo 5MB por foto, apenas imagem
      allow write: if isAuthenticated() &&
                     (firestore.get(/databases/(default)/documents/locations/$(locationId)).data.owner_id == request.auth.uid ||
                      request.auth.uid in firestore.get(/databases/(default)/documents/locations/$(locationId)).data.get('managers', [])) &&
                     isImage() && isUnderSize(5);

      // #1573: owner OU manager do local pode deletar (paridade com Firestore rules)
      allow delete: if isAuthenticated() &&
                      (firestore.get(/databases/(default)/documents/locations/$(locationId)).data.owner_id == request.auth.uid ||
                       request.auth.uid in firestore.get(/databases/(default)/documents/locations/$(locationId)).data.get('managers', []));
    }

    // ============================================
    // FOTOS DE CAMPOS COM FIELDID (Android)
    // Path: locations/{locationId}/fields/{fieldId}/{fileName}
    // #2158: Android usa locations/{locationId}/fields/{fieldId}/photo.jpg e thumb.jpg
    // ============================================
    match /locations/{locationId}/fields/{fieldId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
                     (firestore.get(/databases/(default)/documents/locations/$(locationId)).data.owner_id == request.auth.uid ||
                      request.auth.uid in firestore.get(/databases/(default)/documents/locations/$(locationId)).data.get('managers', [])) &&
                     isImage() && isUnderSize(5);
      allow delete: if isAuthenticated() &&
                      (firestore.get(/databases/(default)/documents/locations/$(locationId)).data.owner_id == request.auth.uid ||
                       request.auth.uid in firestore.get(/databases/(default)/documents/locations/$(locationId)).data.get('managers', []));
    }

    // ============================================
    // FOTOS TEMPORÁRIAS DE CAMPOS
    // Path: temp_fields/{userId}/{timestamp}.jpg
    // NOTA: Usado quando locationId não está disponível no momento do upload
    // SEGURANÇA: Agora inclui userId no path para rastreamento de ownership
    // TODO: Refatorar para passar locationId e usar locations/{locationId}/fields/
    // ============================================
    match /temp_fields/{userId}/{fileName} {
      // Apenas o próprio usuário pode fazer upload em seu diretório
      // Máximo 5MB, apenas imagem
      allow write: if isOwner(userId) && isImage() && isUnderSize(5);

      // Qualquer usuário autenticado pode ler (para preview durante criação)
      allow read: if isAuthenticated();

      // Apenas o dono pode deletar suas fotos temporárias
      allow delete: if isOwner(userId);
    }

    // ============================================
    // FOTOS TEMPORÁRIAS LEGADAS (sem userId no path)
    // Path: temp_fields/{timestamp}.jpg
    // DEPRECADO: Manter apenas para leitura de arquivos antigos
    // Novos uploads devem usar temp_fields/{userId}/{fileName}
    // ============================================
    match /temp_fields/{fileName} {
      // Bloqueia novos uploads no path antigo
      allow write: if false;

      // Permite leitura de arquivos existentes
      allow read: if isAuthenticated();

      // Bloqueia deleção (será feita via script de limpeza)
      allow delete: if false;
    }

    // ============================================
    // FOTOS DE JOGOS (legado)
    // Path: games/{gameId}/photos/{timestamp}.jpg
    // Jogadores confirmados podem postar fotos
    // ============================================
    match /games/{gameId}/photos/{fileName} {
      // Qualquer autenticado pode ver fotos de jogos
      allow read: if isAuthenticated() &&
                     firestore.exists(/databases/(default)/documents/games/$(gameId));

      // #2160: confirmacao exige status == CONFIRMED (nao apenas existencia do doc)
      allow write: if isAuthenticated() &&
                     firestore.exists(/databases/(default)/documents/games/$(gameId)) &&
                     firestore.get(/databases/(default)/documents/games/$(gameId)).data.status in ['CONFIRMED', 'LIVE', 'FINISHED'] &&
                     ((
                       firestore.get(/databases/(default)/documents/confirmations/$(gameId + '_' + request.auth.uid)) != null &&
                       firestore.get(/databases/(default)/documents/confirmations/$(gameId + '_' + request.auth.uid)).data.status == 'CONFIRMED'
                     ) ||
                       firestore.get(/databases/(default)/documents/games/$(gameId)).data.owner_id == request.auth.uid ||
                       request.auth.uid in firestore.get(/databases/(default)/documents/games/$(gameId)).data.get('co_organizers', []) ||
                       isAdmin()) &&
                     isImage() && isUnderSize(10);

      // Uploader ou dono do jogo ou admin pode deletar fotos
      allow delete: if isAuthenticated() &&
                      firestore.exists(/databases/(default)/documents/games/$(gameId)) &&
                      (firestore.get(/databases/(default)/documents/games/$(gameId)).data.owner_id == request.auth.uid ||
                       isAdmin());
    }

    // ============================================
    // FOTOS DE JOGOS (álbum web)
    // Path: games/{gameId}/photos/{userId}/{timestamp}.jpg
    // Jogadores confirmados/organizador podem postar fotos após o jogo.
    // O userId no path permite exclusão segura pelo próprio uploader.
    // ============================================
    match /games/{gameId}/photos/{userId}/{fileName} {
      allow read: if isAuthenticated() &&
                     firestore.exists(/databases/(default)/documents/games/$(gameId));

      allow write: if isOwner(userId) &&
                     firestore.exists(/databases/(default)/documents/games/$(gameId)) &&
                     firestore.get(/databases/(default)/documents/games/$(gameId)).data.status == 'FINISHED' &&
                     ((
                       firestore.get(/databases/(default)/documents/confirmations/$(gameId + '_' + request.auth.uid)) != null &&
                       firestore.get(/databases/(default)/documents/confirmations/$(gameId + '_' + request.auth.uid)).data.status == 'CONFIRMED'
                     ) ||
                       firestore.get(/databases/(default)/documents/games/$(gameId)).data.owner_id == request.auth.uid ||
                       request.auth.uid in firestore.get(/databases/(default)/documents/games/$(gameId)).data.get('co_organizers', []) ||
                       isAdmin()) &&
                     isImage() && isUnderSize(10);

      allow delete: if isAuthenticated() &&
                      firestore.exists(/databases/(default)/documents/games/$(gameId)) &&
                      (request.auth.uid == userId ||
                       firestore.get(/databases/(default)/documents/games/$(gameId)).data.owner_id == request.auth.uid ||
                       request.auth.uid in firestore.get(/databases/(default)/documents/games/$(gameId)).data.get('co_organizers', []) ||
                       isAdmin());
    }

    // ============================================
    // SCREENSHOTS DE FEEDBACK
    // Path: feedback_screenshots/{userId}/{feedbackId}/{fileName}
    // ============================================
    match /feedback_screenshots/{userId}/{feedbackId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isImage() && isUnderSize(5);
    }

    // ============================================
    // REGRA PADRÃO: NEGAR TUDO
    // ============================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
