# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts,java,gradle,properties,swift}]
indent_size = 4
max_line_length = 120

[*.md]
# Dois espaços no fim da linha são quebra de linha em Markdown.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[gradlew.bat]
end_of_line = crlf

[Makefile]
indent_style = tab

[*.{png,jpg,jpeg,gif,ico,ttf,otf,jar,apk,aab,jks,keystore}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
