{
  "name": "functions",
  "version": "1.15.0",
  "scripts": {
    "install:ffmpeg": "node scripts/install-wall-media-ffmpeg.cjs",
    "gcp-build": "npm run install:ffmpeg && npm run build",
    "lint": "eslint .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:perf": "jest --config=jest.perf.config.js --no-coverage --runInBand",
    "test:integration": "npm run build && firebase emulators:exec --only firestore,functions 'jest -c jest.integration.config.js test/integration'",
    "test:mutation": "stryker run",
    "backfill:venues": "npx ts-node src/scripts/backfill-venue-commercial-data.ts",
    "backfill:venues:execute": "npx ts-node src/scripts/backfill-venue-commercial-data.ts --execute"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/logging": "^12.3.0",
    "date-fns": "^4.1.0",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.4.0",
    "geofire-common": "^6.0.0",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.0",
    "js-yaml": "^4.2.0",
    "ts-deepmerge": "8.0.0",
    "uuid": "^11.1.1",
    "typed-rest-client": {
      "qs": "^6.14.1"
    }
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "firebase-functions-test": "^3.4.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.7.3"
  },
  "private": true,
  "license": "UNLICENSED"
}
