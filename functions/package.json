{
  "name": "functions",
  "version": "1.7.11",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:perf": "jest --config=jest.perf.config.js --no-coverage --runInBand",
    "test:integration": "npm run build && firebase emulators:exec --only firestore,functions 'jest -c jest.integration.config.js test/integration'",
    "test:mutation": "stryker run",
    "backfill:venues": "npx ts-node src/scripts/backfill-venue-commercial-data.ts",
    "backfill:venues:execute": "npx ts-node src/scripts/backfill-venue-commercial-data.ts --execute"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google-cloud/logging": "^11.2.1",
    "date-fns": "^4.1.0",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5",
    "geofire-common": "^6.0.0",
    "sharp": "^0.34.5"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.0",
    "js-yaml": "^4.2.0",
    "ts-deepmerge": "8.0.0",
    "uuid": "^11.1.1",
    "typed-rest-client": {
      "qs": "^6.14.1"
    }
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.7.3"
  },
  "private": true
}
