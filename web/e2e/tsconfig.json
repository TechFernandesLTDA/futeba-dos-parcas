{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "../dist-e2e",
    "rootDir": "."
  },
  "include": ["./**/*.ts", "../scripts/seed-e2e-users.ts"],
  "exclude": ["../node_modules"]
}
