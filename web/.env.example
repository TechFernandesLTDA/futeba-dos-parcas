# Firebase Configuration
# Copy this file to .env.local and fill in your values

VITE_FIREBASE_API_KEY=your_firebase_web_api_key
# Em produção, usar o domínio custom: futebadosparcas.com.br.
# Em dev local com Firebase Emulators, pode apontar para localhost (o emulador ignora o authDomain).
VITE_FIREBASE_AUTH_DOMAIN=futebadosparcas.com.br
VITE_FIREBASE_PROJECT_ID=futebadosparcas
VITE_FIREBASE_STORAGE_BUCKET=futebadosparcas.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=490094091078
VITE_FIREBASE_APP_ID=1:490094091078:web:your-app-id

# Google Maps (optional - for location features)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
