# ============================================================
# web/.env.test — Variáveis de ambiente para testes E2E
#
# INSTRUÇÕES:
# 1. Copie este arquivo para web/.env.test
# 2. Preencha com os valores reais (NÃO commite web/.env.test)
# 3. Execute o seed: npm run seed:e2e
# 4. Rode os testes: npm run test:e2e
#
# As credenciais aqui devem corresponder exatamente às criadas
# pelo script scripts/seed-e2e-users.ts no emulador.
# ============================================================

# ──── Emulador Firebase ────────────────────────────────────
# Host do emulador Firebase Auth (obrigatório para seed e testes)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Habilita o modo emulador no web app (necessário para
# que a autenticação aponte para localhost:9099)
# Requer wiring em web/src/services/firebase.ts —
# consulte web/e2e/README.md#emulator-wiring
VITE_USE_EMULATOR=true

# ──── Usuário PLAYER ──────────────────────────────────────
VITE_TEST_PLAYER_EMAIL=test.player@futeba.test
VITE_TEST_PLAYER_PASSWORD=Test123!@#

# ──── Usuário FIELD_OWNER ─────────────────────────────────
VITE_TEST_FIELD_OWNER_EMAIL=test.fieldowner@futeba.test
VITE_TEST_FIELD_OWNER_PASSWORD=Test123!@#

# ──── Usuário ADMIN ───────────────────────────────────────
VITE_TEST_ADMIN_EMAIL=test.admin@futeba.test
VITE_TEST_ADMIN_PASSWORD=Test123!@#
