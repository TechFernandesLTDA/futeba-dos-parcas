{
  "name": "futeba-web",
  "private": true,
  "version": "1.51.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-env.mjs && node node_modules/typescript/bin/tsc && node node_modules/vite/bin/vite.js build",
    "typecheck:test": "tsc --project tsconfig.test.json --noEmit",
    "preview": "vite preview",
    "lint": "node node_modules/eslint/bin/eslint.js . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed:e2e": "tsx ../scripts/seed-e2e-users.ts",
    "lighthouse": "lhci autorun",
    "seed:e2e:groups": "tsx ../scripts/seed-e2e-groups.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.6",
    "@mui/material": "^5.15.6",
    "@mui/x-date-pickers": "^6.19.0",
    "@react-google-maps/api": "^2.20.8",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-virtual": "^3.13.24",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^3.6.0",
    "firebase": "^12.12.1",
    "geofire-common": "^6.0.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.0.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.7",
    "react-router-dom": "^6.21.3",
    "recharts": "^3.8.1",
    "web-vitals": "^4.2.4"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "js-yaml": "^4.2.0",
    "qs": "^6.15.3",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.11.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "firebase-admin": "^13.4.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "rollup-plugin-visualizer": "^6.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
